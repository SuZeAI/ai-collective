# ══════════════════════════════════════════════════════════════════════════════
# AI Collective — Environment Template
# Copy to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM Providers ───────────────────────────────────────────────────────────
# Pick the provider + model for agents, and set the matching API key.
LLM_PROVIDER=google
LLM_MODEL=gemini-3-flash-preview
# LLM_API_BASE=http://localhost:11434/v1   # custom base URL (Ollama / LiteLLM)

# Each key may hold a SINGLE key or SEVERAL keys separated by commas. The plural
# *_API_KEYS aliases work too (e.g. GOOGLE_API_KEYS). With >1 key, the LLM layer
# can rotate across them — see LLM_FAILOVER_STRATEGY below.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── LLM failover strategy ─────────────────────────────────────────────────────
# How to survive per-key rate/quota limits. Two MUTUALLY EXCLUSIVE options:
#   rotate   → built-in multi-key rotation (list several keys above). Rotates
#              reactively on 429/quota/5xx/invalid-key errors AND proactively
#              before a key crosses the per-minute budgets below.        [default]
#   9router  → turn built-in rotation OFF and delegate failover to the 9Router
#              gateway (decolua/9router, docker --profile router). Then also set
#              LLM_PROVIDER=openai + LLM_API_BASE=http://nine-router:20128/v1 and
#              use the dashboard-generated key. (aliases: router, nine-router, off)
LLM_FAILOVER_STRATEGY=rotate
# Proactive per-key budgets (only used when strategy=rotate). 0 = unlimited.
# When a key would cross these within a rolling 60s window it is skipped and the
# next key is used, so the provider's hard RPM/TPM limit is never hit.
LLM_ROTATE_MAX_REQUESTS_PER_MIN=0   # max requests/min per key  (e.g. Gemini free ≈ 15)
LLM_ROTATE_MAX_TOKENS_PER_MIN=0     # max tokens/min   per key  (e.g. Gemini free ≈ 1000000)
LLM_KEY_COOLDOWN_SECONDS=60         # how long an errored key is skipped before retry

# ── 9Router (optional LLM proxy, docker profile: router) ─────────────────────
# Gateway that routes/falls back across providers; only needed when running the
# docker "router" profile. Used as the failover path when LLM_FAILOVER_STRATEGY=9router.
#   Start:     docker compose --profile router up -d
#   Dashboard: http://localhost:20128/dashboard  (log in with ROUTER_INITIAL_PASSWORD)
ROUTER_PORT=20128                                   # host port → localhost access
ROUTER_PUBLIC_URL=http://localhost:20128            # public base URL of the dashboard/API
ROUTER_JWT_SECRET=change-me-use-openssl-rand-hex-32 # dashboard session signing secret
ROUTER_INITIAL_PASSWORD=123456                      # first-login dashboard password (change it!)

# ── Storage ──────────────────────────────────────────────────────────────────
# Where the app reads/writes data: json (file) or mongo. STORAGE_DIR is the live
# DB; SEED_DIR is the default catalog the startup seed copies FROM.
STORAGE_BACKEND=json
STORAGE_DIR=local_database
# SEED_DIR=storage

# ── MongoDB (used when STORAGE_BACKEND=mongo) ────────────────────────────────
# Connection string + database name; only used when STORAGE_BACKEND=mongo.
MONGO_URI=mongodb://admin:admin@localhost:27017/ai_collective?authSource=admin
MONGO_DB=ai_collective

# ── Graph Knowledge Extraction ───────────────────────────────────────────────
# How conversation knowledge graphs are built: static (spaCy, no token cost) or
# llm (richer, costs tokens). Optionally use a dedicated model for graph work.
GRAPH_BUILD_MODE=static
# GRAPH_LLM_PROVIDER=google
# GRAPH_LLM_MODEL=gemini-3-flash-preview

# ── Task Queue ─────────────────────────────────────────────────────────────────
# Queue that runs tasks: memory (single instance) or rabbitmq (multi-instance / Docker).
TASK_QUEUE_BACKEND=memory
TASK_QUEUE_MAX_CONCURRENT=3
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ── Repository Lock ────────────────────────────────────────────────────────────
# Write lock for data: threading (single instance) or redis (multi-instance / Docker).
LOCK_BACKEND=threading
# REDIS_URL=redis://localhost:6379/0

# ── Sandbox ────────────────────────────────────────────────────────────────────
# Where agents run shell/code commands: local (on host), docker, or k8s.
# The SANDBOX_* vars below are only needed for the docker/k8s modes.
SANDBOX_MODE=local
SANDBOX_TIMEOUT=120
# SANDBOX_WORKSPACE=/path/to/workspace
# docker mode:
# SANDBOX_IMAGE=enterprise-public-cn-beijing.cr.volces.com/vefaas-public/all-in-one-sandbox:latest
# SANDBOX_BASE_PORT=8080
# SANDBOX_CONTAINER_PREFIX=ai-collective-sandbox
# SANDBOX_REPLICAS=3
# SANDBOX_IDLE_TIMEOUT=600
# SANDBOX_HOST=localhost
# k8s mode:
# SANDBOX_PROVISIONER_URL=http://provisioner:8002

# ── JWT / Authentication ───────────────────────────────────────────────────────
# Login token signing secret + algorithm + lifetime. Change the secret in
# production (openssl rand -hex 32). 10080 minutes = 7 days.
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Google OAuth — Social Sign-in ──────────────────────────────────────────────
# Sign in with Google. Create credentials in Google Cloud Console; the redirect
# URI must match what's registered there.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

# ── Google OAuth — Workspace / Tool Integration ────────────────────────────────
# OAuth for workspace tools (Drive/Docs/Sheets...). You can point to a
# client_secret JSON file instead of inlining the values.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oauth/callback
# GOOGLE_OAUTH_CLIENT_SECRET_PATH=/path/to/client_secret.json

# ── Application ────────────────────────────────────────────────────────────────
# Runtime environment + CORS + frontend/API URLs. production enforces a strong JWT secret.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:2026
FRONTEND_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ── Logging ────────────────────────────────────────────────────────────────────
# Log level and where logs go (console / file).
LOG_LEVEL=info
LOG_CONSOLE=true
LOG_FILE=false

# ── Agent Working Memory ───────────────────────────────────────────────────────
# Shared per-conversation blackboard that keeps multi-agent runs from losing
# context. When notes exceed the token budget, older ones are summarized.
WORKING_MEMORY_ENABLED=true
WORKING_MEMORY_MAX_NOTES=40
WORKING_MEMORY_COMPACT_TOKENS=1500
WORKING_MEMORY_NOTE_CHARS=600
WORKING_MEMORY_SUMMARY_CHARS=3000
WORKING_MEMORY_DIGEST_CHARS=4000

# ── MCP (Model Context Protocol) ───────────────────────────────────────────────
# Timeouts for MCP servers (per-skill config lives elsewhere, see docs/MCP_GUIDE.md).
MCP_DISCOVERY_TIMEOUT_SECONDS=30
MCP_CALL_TIMEOUT_SECONDS=60

# ── Admin bootstrap ──────────────────────────────────────────────────────────
# Admin account created/synced into the users store on every backend boot.
# Change ADMIN_PASSWORD before real use; leave it empty to disable the auto-seed.
ADMIN_EMAIL=admin@aicollective.com
ADMIN_PASSWORD=ChangeMe_Admin@123
ADMIN_NAME=Administrator
ADMIN_AUTO_SEED=true

# ── Default catalog seed ─────────────────────────────────────────────────────
# When true, import the bundled default agents/skills/teams into an empty DB on boot.
SEED_DEFAULT_DATA=true
