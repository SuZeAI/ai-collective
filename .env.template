# MongoDB
MONGO_URI=mongodb://admin:admin@localhost:27017/ai_collective?authSource=admin

# Qdrant vector store
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Neo4j knowledge graph
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=neo4j_password

# Task queue / lock
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# REDIS_URL=redis://localhost:6379/0

# Admin bootstrap
ADMIN_PASSWORD=ChangeMe_Admin@123

# Sandbox mode/workspace/provisioner URL, MinIO enabled/endpoint/bucket/secure,
# and tool defaults (BIRD_SEARCH_MJS/XAI_MODEL/TTS_OUTPUT_DIR/GOOGLE_*_TOKEN_PATH)
# are non-secret ops config — set them in config.yml (sandbox:/minio:/tools:
# sections), not here.

# Sandbox k3s mode (docker-compose / provisioner service, not read by the app)
# KUBECONFIG=/home/<user>/.kube/config
# K8S_API_SERVER=https://host.docker.internal:6443
# NODE_HOST=host.docker.internal
# SKILLS_HOST_PATH=/abs/path/to/skills
# THREADS_HOST_PATH=/abs/path/to/backend/.ai-collective/threads

# MinIO credentials (config.yml's minio.access_key/secret_key reference these)
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin

# MCP extension secrets
# GITHUB_TOKEN=
