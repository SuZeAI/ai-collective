# ══════════════════════════════════════════════════════════════════════════════
# AI Collective — Environment Template
# Copy to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM Providers ─────────────────────────────────────────────────────────────
LLM_PROVIDER=google
LLM_MODEL=gemini-2.0-flash

GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional: custom base URL for LLM API (e.g. local Ollama, LiteLLM proxy)
# LLM_API_BASE=http://localhost:11434/v1

# ── 9Router — multi-provider LLM proxy (optional) ──────────────────────────────
# OpenAI-compatible gateway that routes/falls back across 40+ providers and
# compresses tokens. Run it with: docker compose --profile router up -d
# Then create an API key + combo in the dashboard (http://localhost:20128/dashboard)
# and route the backend through it via the OpenAI provider:
#   LLM_PROVIDER=openai
#   LLM_API_BASE=http://nine-router:20128/v1   # in Docker; use http://localhost:20128/v1 when backend runs on host
#   OPENAI_API_KEY=sk-...                       # the key generated in the 9router dashboard
#   LLM_MODEL=cc/claude-opus-4-7                # a combo name or provider/model
# See docs/9ROUTER_SETUP.md for the full walkthrough.
#
# 9Router container settings (consumed by docker-compose, profile: router):
ROUTER_PORT=20128
ROUTER_PUBLIC_URL=http://localhost:20128
# IMPORTANT: change in production — generate with: openssl rand -hex 32
ROUTER_JWT_SECRET=change-me-use-openssl-rand-hex-32

# ── Storage ────────────────────────────────────────────────────────────────────
# "json" → file-based storage (default, no setup needed)
# "mongo" → MongoDB (requires MongoDB running, set MONGO_URI below)
STORAGE_BACKEND=json

# Override default storage directory for JSON files (default: <project_root>/storage)
# STORAGE_DIR=/data/ai-collective/storage

# ── MongoDB ────────────────────────────────────────────────────────────────────
# Used when STORAGE_BACKEND=mongo
# Docker: use service name "mongodb"; local: use "localhost"
MONGO_URI=mongodb://admin:admin@localhost:27017/ai_collective?authSource=admin
MONGO_DB=ai_collective

# ─── Graph Knowledge Extraction ───────────────────────────────────────────────
# Graph build mode for building conversation knowledge graphs:
#   "static"  - rule-based / spaCy NLP pipeline (fast, no LLM cost, default)
#   "llm"     - LLM-based entity & relation extraction (richer, uses token budget)
GRAPH_BUILD_MODE=static

# Optional: dedicated LLM provider/model for graph extraction.
# When unset, falls back to the main LLM_PROVIDER / LLM_MODEL.
# Useful to use a cheaper/faster model (e.g. gemini-flash) specifically for graph.
# GRAPH_LLM_PROVIDER=google
# GRAPH_LLM_MODEL=gemini-3-flash-preview

# ── Task Queue ─────────────────────────────────────────────────────────────────
# "memory" → in-process queue (default, single instance)
# "rabbitmq" → RabbitMQ (required for multi-instance / Docker deployment)
TASK_QUEUE_BACKEND=memory
TASK_QUEUE_MAX_CONCURRENT=3
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ── Repository Lock ────────────────────────────────────────────────────────────
# "threading" → in-process lock (default, single instance)
# "redis"     → Redis (required for multi-instance / Docker deployment)
LOCK_BACKEND=threading
# REDIS_URL=redis://localhost:6379/0

# ── Sandbox ────────────────────────────────────────────────────────────────────
# Mode options:
#   "local"  → commands run directly on the host (default, dev-only, no isolation)
#   "docker" → commands run inside local Docker containers (auto-managed)
#   "k8s"    → commands run inside K8s/k3s pods via provisioner service
SANDBOX_MODE=local
SANDBOX_TIMEOUT=120

# Local mode: workspace directory for command execution
# SANDBOX_WORKSPACE=/path/to/workspace

# Docker mode settings (used when SANDBOX_MODE=docker)
# SANDBOX_IMAGE=enterprise-public-cn-beijing.cr.volces.com/vefaas-public/all-in-one-sandbox:latest
# SANDBOX_BASE_PORT=8080
# SANDBOX_CONTAINER_PREFIX=ai-collective-sandbox
# SANDBOX_REPLICAS=3
# SANDBOX_IDLE_TIMEOUT=600
# SANDBOX_HOST=localhost       (use host.docker.internal when running inside Docker)

# K8s/k3s mode settings (used when SANDBOX_MODE=k8s)
# SANDBOX_PROVISIONER_URL=http://provisioner:8002

# ── JWT / Authentication ───────────────────────────────────────────────────────
# IMPORTANT: change this in production!  Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Google OAuth — Social Sign-in ──────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
# Redirect URI registered in Google Cloud Console:
GOOGLE_LOGIN_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

# ── Google OAuth — Workspace / Tool Integration ────────────────────────────────
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oauth/callback
# Path to Google OAuth client_secret JSON file (for workspace integrations)
# GOOGLE_OAUTH_CLIENT_SECRET_PATH=/path/to/client_secret.json

# ── Application ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
# CORS_ORIGINS=http://localhost:5173,http://localhost:2026
FRONTEND_URL=http://localhost:8080

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_CONSOLE=true
LOG_FILE=false
