# AI Collective secrets
# cp .env.template .env
# Non-secret ops config (sandbox mode, minio, storage, graph/vector backends, tool
# defaults) lives in .config/config.yml, not here — this file is keys + local paths only.

# LLM provider keys
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
KIMI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=

# 9Router gateway
ROUTER_JWT_SECRET=change-me-use-openssl-rand-hex-32
ROUTER_INITIAL_PASSWORD=123456

# JWT auth
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Google OAuth login
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# Google Workspace tools (secret file path — machine-specific)
GOOGLE_OAUTH_CLIENT_SECRET_PATH=
CREDENTIALS_PATH=
SERVICE_ACCOUNT_PATH=

# MongoDB (URI embeds credentials)
MONGO_URI=mongodb://admin:admin@localhost:27017/ai_collective?authSource=admin

# Qdrant vector store
QDRANT_API_KEY=

# Neo4j knowledge graph
NEO4J_PASSWORD=neo4j_password

# Task queue / lock
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
REDIS_URL=redis://localhost:6379/0

# Admin bootstrap
ADMIN_PASSWORD=ChangeMe_Admin@123

# MinIO credentials
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Sandbox workspace — machine-specific absolute path
SANDBOX_WORKSPACE=/abs/path/to/.artifact/sandbox_workspace
THREADS_HOST_PATH=/abs/path/to/.artifact/sandbox_workspace/threads

# k3s provisioner (docker-compose profile: provisioner — not read by config.yml)
KUBECONFIG=/home/<user>/.kube/config
K8S_API_SERVER=https://host.docker.internal:6443
NODE_HOST=host.docker.internal
SKILLS_HOST_PATH=/abs/path/to/skills

# MCP extension secrets
GITHUB_TOKEN=
EXAMPLE_MCP_TOKEN=
