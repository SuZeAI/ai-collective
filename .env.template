# ══════════════════════════════════════════════════════════════════════════════
# AI Collective — Secrets (.env)
# Copy to .env and fill in your values.  →  cp .env.template .env
# ──────────────────────────────────────────────────────────────────────────────
# This file holds ONLY SECRETS (API keys, signing secrets, credentials).
# Non-secret operational config (provider/model, modes, timeouts, ports, URLs,
# budgets) lives in config.yml — edit that for behavior changes.
#
# Layering, low → high priority:
#     code defaults  <  config.yml  <  .env  <  OS environment
# Anything you set here overrides config.yml. You may also override any
# config.yml key here if you need an environment-specific value.
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM provider API keys ─────────────────────────────────────────────────────
# Each may hold ONE key or SEVERAL comma-separated keys (enables rotation — see
# config.yml › llm_failover). Plural *_API_KEYS aliases also work.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# KIMI_API_KEY=

# ── 9Router gateway secrets (docker profile: router) ──────────────────────────
ROUTER_JWT_SECRET=change-me-use-openssl-rand-hex-32   # dashboard session signing secret
ROUTER_INITIAL_PASSWORD=123456                        # first-login dashboard password (change it!)

# ── JWT / Authentication ──────────────────────────────────────────────────────
# Change in production: openssl rand -hex 32  (production refuses to start on the default).
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ── Google OAuth — Social Sign-in ─────────────────────────────────────────────
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# ── Google OAuth — Workspace / Tool Integration ───────────────────────────────
# GOOGLE_OAUTH_CLIENT_SECRET_PATH=/path/to/client_secret.json

# ── MongoDB (used when STORAGE_BACKEND=mongo) ─────────────────────────────────
# Connection string holds credentials. The DB name is in config.yml › mongo.
MONGO_URI=mongodb://admin:admin@localhost:27017/ai_collective?authSource=admin

# ── Task queue / lock (multi-instance backends) ───────────────────────────────
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# REDIS_URL=redis://localhost:6379/0

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# Account synced into the users store on boot (email/name/auto-seed → config.yml).
ADMIN_PASSWORD=ChangeMe_Admin@123

# ── MCP extension secrets (referenced from mcp.yml via ${VAR}) ────────────────
# GITHUB_TOKEN=
# EXAMPLE_MCP_TOKEN=
