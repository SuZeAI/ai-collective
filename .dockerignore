# Version control & CI
.git
.gitignore
.github

# Python caches / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Secrets & local config — must never be baked into the image
.env
.env.*
.secrets/
*.pem
*.key

# Local runtime data & logs
logs/
storage/
*.db
*.sqlite3
sandbox_workspace/
static/avatars/

# Build outputs / installable artifacts (regenerated inside the image).
# NOTE: the build context (repo root) is shared by ui/Dockerfile, which
# needs ui/ — do NOT ignore that here.
node_modules/
dist/
build/

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
